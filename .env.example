# Server
DATABASE_URL=postgresql://user:password@localhost:5432/extia_gaming
JWT_SECRET=change-me-to-a-random-32-char-minimum-string
REFRESH_SECRET=change-me-to-another-random-32-char-minimum-string
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development

# Client
VITE_API_URL=http://localhost:3000

# Optional Web Push reminders (server only; never prefix the private key with VITE_)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.org
# Optional reminders: timing and channel choices are editable in event/admin settings.
# Server-side settings only. Restart the server after changing them.
PUBLIC_SITE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DISCORD_WEBHOOK_URL=
