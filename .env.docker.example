# Copy to .env.docker. Generate three independent secrets (at least 32 characters).
POSTGRES_PASSWORD=
JWT_SECRET=
REFRESH_SECRET=

# Production HTTPS. Point the domain DNS to the Docker host and open TCP 80/443.
# Caddy obtains and renews the certificate and redirects HTTP to HTTPS.
SITE_ADDRESS=https://24hsolidaires.fr
PUBLIC_SITE_URL=https://24hsolidaires.fr
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# External notifications are blocked by the private network.
# SMTP_*, VAPID_* and DISCORD_WEBHOOK_URL alone do not enable network access.
