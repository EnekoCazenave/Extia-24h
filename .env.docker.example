# Copy to .env.docker. Generate three independent secrets (at least 32 characters).
POSTGRES_PASSWORD=
JWT_SECRET=
REFRESH_SECRET=

# Local smoke test. Production settings are explained in docs/deploiement-docker.md.
SITE_ADDRESS=http://localhost
PUBLIC_SITE_URL=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Optional notifications: copy SMTP_*, VAPID_* and DISCORD_WEBHOOK_URL
# from .env.example into .env.docker when needed.
