generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  groupId Int?
  group OrganizationGroup? @relation(fields: [groupId], references: [id])
  eventAwards EventAward[]
  id                        Int                        @id @default(autoincrement())
  login                     String
  password                  String
  lastname                  String
  firstname                 String
  intern                    Boolean                    @default(false)
  email                     String                     @unique
  role                      Role                       @relation(fields: [roleId], references: [id])
  roleId                    Int
  userGames                 UserGame[]
  userTeams                 UserTeam[]
  achievements              UserAchievement[]
  userEvents                UserEvent[]
  refreshTokens             RefreshToken[]
  bonusesReceived           PointBonus[]               @relation("BonusReceiver")
  bonusesGranted            PointBonus[]               @relation("BonusGranter")
  submittedSessions         GameSession[]              @relation("SubmittedSessions")
  sessionMemberships        GameSessionMember[]
  subscriptionNotifications SubscriptionNotification[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model VideoGame {
  id             Int        @id @default(autoincrement())
  nom            String
  imageUrl       String?
  happyHourStart DateTime?
  happyHourEnd   DateTime?
  gameTypes      GameType[]
  events         Event[]
}

enum CalculType {
  BOOLEAN
  NUMBER
  TIME
  RULES
}

model GameType {
  id           Int           @id @default(autoincrement())
  name         String
  calculType   CalculType
  calculConfig Json
  win          String
  team         Boolean       @default(false)
  maxPlaysPerUser Int?
  maxPointsPerUser Float?
  videoGame    VideoGame     @relation(fields: [videoGameId], references: [id])
  videoGameId  Int
  teams        Team[]
  userGames    UserGame[]
  gameSessions GameSession[]
}

model Team {
  id         Int        @id @default(autoincrement())
  gameType   GameType   @relation(fields: [gameTypeId], references: [id])
  gameTypeId Int
  members    UserTeam[]
}

model UserTeam {
  team   Team @relation(fields: [teamId], references: [id])
  teamId Int
  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@id([teamId, userId])
}

model UserGame {
  id            Int          @id @default(autoincrement())
  user          User         @relation(fields: [userId], references: [id])
  userId        Int
  gameType      GameType     @relation(fields: [gameTypeId], references: [id])
  gameTypeId    Int
  score         Float        @default(0)
  playedAt      DateTime     @default(now())
  gameSession   GameSession? @relation(fields: [gameSessionId], references: [id])
  gameSessionId Int?

  @@unique([gameSessionId, userId])
}

enum SessionStatus {
  PENDING
  APPROVED
  REJECTED
}

model GameSession {
  id          Int                 @id @default(autoincrement())
  submitter   User                @relation("SubmittedSessions", fields: [submitterId], references: [id])
  submitterId Int
  gameType    GameType            @relation(fields: [gameTypeId], references: [id])
  gameTypeId  Int
  score       Float
  scoringData Json?
  proofUrl    String?
  status      SessionStatus       @default(PENDING)
  createdAt   DateTime            @default(now())
  reviewedAt  DateTime?
  teamMembers GameSessionMember[]
  userGames   UserGame[]
}

model GameSessionMember {
  session   GameSession @relation(fields: [sessionId], references: [id])
  sessionId Int
  user      User        @relation(fields: [userId], references: [id])
  userId    Int

  @@id([sessionId, userId])
}

model PointBonus {
  id          Int      @id @default(autoincrement())
  user        User     @relation("BonusReceiver", fields: [userId], references: [id])
  userId      Int
  grantedBy   User     @relation("BonusGranter", fields: [grantedById], references: [id])
  grantedById Int
  points      Int
  reason      String?
  createdAt   DateTime @default(now())
}

model Achievement {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  users       UserAchievement[]
}

model UserAchievement {
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId Int

  @@id([userId, achievementId])
}

model Event {
  notifyPush Boolean @default(true)
  notifyEmail Boolean @default(false)
  notifyDiscord Boolean @default(false)
  reminderMinutes Int @default(10)
  channelDeliveries EventChannelDelivery[]
  id          Int      @id @default(autoincrement())
  name        String
  description String
  startsAt    DateTime
  endsAt      DateTime
  maxPlaces   Int

  videoGameId Int?
  videoGame   VideoGame? @relation(fields: [videoGameId], references: [id])

  userEvents UserEvent[]

  twitchUrl String?
  winnerShare Float @default(0.05)
  winnerId Int?
  settledAt DateTime?
  awards EventAward[]
  pointsEarned Float

  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  notificationDeliveries EventNotificationDelivery[]
}

model UserEvent {
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  registeredAt DateTime @default(now())
  isPresent    Boolean?

  @@id([userId, eventId])
  @@index([eventId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
}

enum BlockType {
  HEADING
  TEXT
  IMAGE
  VIDEO
  CTA_BUTTON
  PROGRESS_BAR
  DONATION_LINK
  QUOTE
}

model Association {
  id        Int                @id @default(autoincrement())
  name      String
  slug      String             @unique
  logoUrl   String?
  published Boolean            @default(false)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  blocks    AssociationBlock[]
}

model AssociationBlock {
  id            Int         @id @default(autoincrement())
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  associationId Int
  type          BlockType
  sortOrder     Int         @default(0)
  content       Json
}

model SubscriptionNotification {
  id                          Int                         @id @default(autoincrement())
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                      Int
  endpoint                    String                      @unique
  p256dh                      String
  auth                        String
  expirationTime              DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  eventNotificationDeliveries EventNotificationDelivery[]

  @@index([userId])
}

model EventNotificationDelivery {
  id             Int       @id @default(autoincrement())
  eventId        Int
  subscriptionId Int
  sentAt         DateTime?
  leaseUntil DateTime?
  attempts Int @default(0)

  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription SubscriptionNotification @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([eventId, subscriptionId])
}

model EventAward {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  eventId Int
  event Event @relation(fields: [eventId], references: [id])
  points Float
  createdAt DateTime @default(now())
  @@unique([eventId, userId])
}

model OrganizationGroup {
  id Int @id @default(autoincrement())
  name String @unique
  kind String @default("AGENCY")
  active Boolean @default(true)
  users User[]
  points GroupPoint[]
}

model GroupPoint {
  id Int @id @default(autoincrement())
  groupId Int
  group OrganizationGroup @relation(fields: [groupId], references: [id])
  points Float
  reason String
  grantedById Int
  createdAt DateTime @default(now())
}

model SiteSettings {
  notifyStartDiscord Boolean @default(false)
  notifyEndDiscord Boolean @default(false)
  startReminderMinutes Int @default(0)
  endReminderMinutes Int @default(0)
  discordUrl String?
  honorTiers Json @default("[]")
  id Int @id @default(1)
  eventStart DateTime?
  eventEnd DateTime?
}

model ProjectTask {
  id Int @id @default(autoincrement())
  title String
  description String @default("")
  assignee String @default("")
  status String @default("TODO")
  updatedAt DateTime @updatedAt
}

model EventChannelDelivery {
  id Int @id @default(autoincrement())
  eventId Int
  event Event @relation(fields:[eventId], references:[id], onDelete:Cascade)
  destination String
  sentAt DateTime?
  leaseUntil DateTime?
  attempts Int @default(0)
  @@unique([eventId,destination])
}

model SiteNotificationDelivery {
  id Int @id @default(autoincrement())
  kind String
  scheduledAt DateTime
  sentAt DateTime?
  leaseUntil DateTime?
  attempts Int @default(0)
  @@unique([kind,scheduledAt])
}
